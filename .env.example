# Variáveis de ambiente — NeuroBlog
# Copie este arquivo para .env.local e preencha com os valores do seu projeto Supabase.
# (Supabase Studio → Project Settings → API)

NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-publica
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-secreta

# URL pública do site (usada em SEO: canonical, sitemap, OG, RSS)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sem essas variáveis o site roda em MODO DEMO (conteúdo fictício, sem persistência).
